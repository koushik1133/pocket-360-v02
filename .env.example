NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production. Local development can opt into file persistence below.
DATABASE_URL=
# Development/QA only. Keep false in production and configure DATABASE_URL.
ALLOW_FILE_APPOINTMENTS=false

# Anthropic (https://console.anthropic.com). Powers the AI assistant chat.
# Leave empty to run the assistant in fallback mode (canned reply + contact CTAs).
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5. For a high-volume support
# widget you may prefer a faster/cheaper model, e.g. claude-haiku-4-5.
ASSISTANT_MODEL=

# Resend (https://resend.com). Leave empty to skip sending; the UI will not fake success.
RESEND_API_KEY=
APPOINTMENT_FROM_EMAIL=
APPOINTMENT_NOTIFY_EMAIL=
APPOINTMENT_FROM_NAME=Pocket Reels 360

# Public contact. Do not invent numbers. Leave empty to hide WhatsApp CTAs.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
