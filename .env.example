# Pocket Reels 360 - Production Environment Variables for Vercel

# ─── 1. Essential Keys ───
# Groq API key for the AI production assistant (llama-3.3-70b-versatile or openai/gpt-oss-120b)
GROQ_API_KEY=

# Groq model override (optional, defaults to openai/gpt-oss-120b)
ASSISTANT_MODEL=openai/gpt-oss-120b


# ─── Email (pick ONE transport) ───
# Option A — send from your own Gmail / Google Workspace address.
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Paste it below (spaces are fine). Clients receive mail FROM this address
#      and replies come straight back to your inbox.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Option B — Resend. Only a verified custom domain can send to clients;
# onboarding@resend.dev can only deliver to the Resend account owner.
RESEND_API_KEY=
APPOINTMENT_FROM_EMAIL=Pocket Reels 360 <hello@your-verified-domain.com>

# Where internal "new booking" notifications are delivered (both transports)
APPOINTMENT_NOTIFY_EMAIL=
APPOINTMENT_FROM_NAME=Pocket Reels 360

# 4-digit PIN for /admin dashboard (default: 9912)
ADMIN_PASSWORD=9912

# ─── 2. Database & Persistence (Vercel Serverless) ───
# Option A: Supabase via the JS client (preferred on Vercel).
# Use the SERVICE ROLE key server-side; it never reaches the browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy: anon key still works until migration 002 is applied.
SUPABASE_ANON_KEY=

# Option B: direct PostgreSQL connection string (run `npm run db:migrate`)
DATABASE_URL=

# Keep true only until a database is connected. On Vercel the file store is
# /tmp and is wiped between deployments, so bookings are NOT durable.
ALLOW_FILE_APPOINTMENTS=true

# ─── 3. Optional Public Brand Overrides ───
NEXT_PUBLIC_SITE_URL=https://pocket360.vercel.app
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

