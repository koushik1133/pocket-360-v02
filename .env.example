NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required in production. Local development can opt into file persistence below.
DATABASE_URL=
# Development/QA only. Keep false in production and configure DATABASE_URL.
ALLOW_FILE_APPOINTMENTS=false

# Resend (https://resend.com). Leave empty to skip sending; the UI will not fake success.
RESEND_API_KEY=
APPOINTMENT_FROM_EMAIL=
APPOINTMENT_NOTIFY_EMAIL=
APPOINTMENT_FROM_NAME=Pocket Reels 360

# Public contact. Do not invent numbers. Leave empty to hide WhatsApp CTAs.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
