# Pocket Reels 360 - Production Environment Variables for Vercel

# ─── 1. Essential Keys ───
# Groq API key for the AI production assistant (llama-3.3-70b-versatile or openai/gpt-oss-120b)
GROQ_API_KEY=

# Model override (optional, defaults to openai/gpt-oss-120b or llama-3.3-70b-versatile)
ASSISTANT_MODEL=openai/gpt-oss-120b

# Resend API key for instant booking confirmation emails
RESEND_API_KEY=

# Sender email address (default onboarding@resend.dev or your custom verified domain)
APPOINTMENT_FROM_EMAIL=Pocket Reels 360 <onboarding@resend.dev>

# Where internal booking notifications are delivered
APPOINTMENT_NOTIFY_EMAIL=koushik.lf38@gmail.com

# 4-digit PIN for /admin dashboard (default: 9912)
ADMIN_PASSWORD=9912

# ─── 2. Database & Persistence (Vercel Serverless) ───
# Supabase / PostgreSQL connection string
DATABASE_URL=

# Keep true if you want bookings to succeed even if DATABASE_URL is not yet connected
ALLOW_FILE_APPOINTMENTS=true

# ─── 3. Optional Public Brand Overrides ───
NEXT_PUBLIC_SITE_URL=https://pocket360.vercel.app
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

